# Copy this file to backend/.env and fill in your own values.
# backend/.env is ignored by git: it must NEVER be uploaded to GitHub.

# Port of the API server (Render sets PORT automatically).
PORT=5000

# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers).
# Replace <db_password> with the password of your Atlas database user.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/gift_inventory?retryWrites=true&w=majority

# Long random secret that signs the sign-in tokens (at least 32 characters).
# Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value

# Address of the frontend that may call this API (CORS). Several: separate with commas.
# Local:      http://localhost:5173
# Production: https://YOUR-VERCEL-DOMAIN.vercel.app
FRONTEND_URL=http://localhost:5173

# First admin account. It is created when the database is empty, and it can always sign in
# after a backup restore. Use a strong password (at least 8 characters, letters and numbers).
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=

# ---------- optional ----------
# NODE_ENV=production
# Load the starting data (7 promoters with fixed logins, 7 shops, 4 gifts, models, brands) into an EMPTY database.
# SEED_DATA=true
# Business time zone for "today" and daily / monthly reports.
# TZ=Asia/Karachi
# How long a sign-in lasts.
# JWT_EXPIRES_IN=12h
# Also allow Vercel preview addresses (https://<anything>.vercel.app).
# ALLOW_VERCEL_PREVIEWS=false
# Largest photo upload (MB) and largest backup file for restore (MB).
# MAX_PHOTO_MB=6
# RESTORE_MAX_MB=100
# Behind a proxy (Render): true. Set automatically in production.
# TRUST_PROXY=true
