# Address of the backend REST API (ends with /api).
# Local development:
VITE_API_URL=http://localhost:5000/api
# Production (Vercel → Project → Settings → Environment Variables):
# VITE_API_URL=https://YOUR-RENDER-BACKEND.onrender.com/api
#
# Only public values belong here: everything in VITE_* is visible in the browser.
# Never put database passwords, JWT secrets or other secrets in the frontend.
